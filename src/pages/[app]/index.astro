---
import { Image } from 'astro:assets';
import AppPage from '../../layouts/AppPage.astro';
import FeatureIcon from '../../components/FeatureIcon.astro';
import { apps } from '../../data/apps';
import type { AppInfo } from '../../data/types';

export function getStaticPaths() {
  return apps.map((app) => ({ params: { app: app.slug }, props: { app } }));
}

const { app } = Astro.props as { app: AppInfo };
const hero = app.screenshots[0];
const stores = [app.stores.ios, app.stores.android];
// The last word of the headline gets the brand accent.
const headWords = app.hero.headline.split(' ');
const headAccent = headWords.pop();
---

<AppPage app={app} current="overview" title={`${app.name}: ${app.tagline}`} description={app.blurb}>
  <main>
    <div class="hero">
      <div class="wrap">
        <div class="grid">
          <div class="hero-copy">
            <p class="eyebrow">{app.name}</p>
            <h1>{headWords.join(' ')} <span class="accent-text">{headAccent}</span></h1>
            <p class="lead">{app.hero.sub}</p>

            <div class="btn-row">
              {app.webApp && <a class="btn primary big" href={app.webApp.url}>{app.webApp.label} →</a>}
              {stores.map((s) =>
                s.url ? (
                  <a class="btn store" href={s.url}>{s.label}</a>
                ) : (
                  <span class="btn store soon" aria-disabled="true">
                    {s.label} <small>Coming soon</small>
                  </span>
                )
              )}
            </div>

            <ul class="facts" aria-label="At a glance">
              {app.hero.facts.map((f) => <li>{f}</li>)}
            </ul>
          </div>
          <div class="hero-visual">
            <Image class="hero-shot" src={hero.src} alt={hero.alt} width={320} loading="eager" />
          </div>
        </div>
      </div>
    </div>

    <section id="features">
      <div class="wrap">
        <h2>Everything in one place</h2>
        <p class="section-sub">Stop juggling separate apps for training, food, sleep and mood.</p>
        <div class="features">
          {app.features.map((f) => (
            <div class="card feature reveal">
              <span class="icon-tile"><FeatureIcon name={f.icon} /></span>
              <h3>{f.title}</h3>
              <p class="feature-sum">{f.summary}</p>
              <ul>{f.points.map((p) => <li>{p}</li>)}</ul>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section id="screens">
      <div class="wrap">
        <h2>A look inside</h2>
        <p class="section-sub">Swipe or scroll to see more.</p>
        <div class="shots" tabindex="0" role="region" aria-label={`${app.name} screenshots`}>
          {app.screenshots.map((s) => (
            <figure class="reveal">
              <Image src={s.src} alt={s.alt} width={280} />
              <figcaption>{s.caption}</figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>

    {app.pricing && (
      <section id="pricing">
        <div class="wrap">
          <h2>Free to start</h2>
          <p class="section-sub">Upgrade only if you want more. Cancel any time.</p>
          <div class="pricing">
            <div class="card plan reveal">
              <h3>{app.pricing.free.title}</h3>
              <div class="price">{app.pricing.free.price}</div>
              <ul>{app.pricing.free.points.map((p) => <li>{p}</li>)}</ul>
            </div>
            <div class="card plan featured reveal">
              <h3>{app.pricing.premium.title}</h3>
              <div class="price">{app.pricing.premium.price}</div>
              <ul>{app.pricing.premium.points.map((p) => <li>{p}</li>)}</ul>
              {app.pricing.premium.note && <p class="price-note">{app.pricing.premium.note}</p>}
            </div>
          </div>
        </div>
      </section>
    )}

    <section>
      <div class="wrap narrow">
        <div class="notice">{app.notice}</div>
      </div>
    </section>

    <section id="faq">
      <div class="wrap narrow">
        <h2>Questions</h2>
        <div class="faq">
          {app.faqs.map((f) => (
            <details>
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))}
        </div>
        <p style="margin-top:24px"><a href={`/${app.slug}/support/`}>More help and contact →</a></p>
      </div>
    </section>

    {app.webApp && (
      <section class="cta-band">
        <div class="wrap narrow">
          <h2>Ready to try it?</h2>
          <p class="section-sub">It is free to start, and it takes a minute to set up.</p>
          <a class="btn primary big" href={app.webApp.url}>{app.webApp.label} →</a>
        </div>
      </section>
    )}
  </main>
</AppPage>
