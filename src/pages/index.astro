---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { company } from '../data/company';
import { apps } from '../data/apps';
---

<Base title={company.name} description={`${company.name} builds apps that make everyday life a little easier. Meet FitNFree, our AI health companion.`}>
  <main>
    <div class="hero">
      <div class="wrap">
        <p class="eyebrow">{company.name}</p>
        <h1>{company.tagline}</h1>
        <p class="lead">
          One small team, a growing set of apps. Each one has its own page here with everything you need:
          what it does, how to get it, and how it looks after your data.
        </p>
      </div>
    </div>

    <section id="apps">
      <div class="wrap">
        <h2>Our apps</h2>
        <p class="section-sub">More are on the way.</p>
        <div class="app-grid">
          {apps.map((app) => (
            <a class="app-card" href={`/${app.slug}/`}>
              <Image src={app.icon} alt={`${app.name} icon`} width={72} height={72} />
              <div>
                <h3>{app.name}</h3>
                <p>{app.blurb}</p>
                <span class="go">Learn more →</span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section id="games">
      <div class="wrap">
        <h2>Free games</h2>
        <p class="section-sub">Short, hands-on cyber security training you can play in your browser. No sign-up, and nothing tracked.</p>
        <a class="app-card games-card" href="/games/">
          <span class="games-tile" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="34" height="34" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l7 3v5c0 4.5-3 8-7 10-4-2-7-5.5-7-10V6z"/><path d="M9 12l2 2 4-4"/></svg>
          </span>
          <div>
            <h3>RootLine</h3>
            <p>Spot phishing, run an incident, investigate evidence and resist social engineers. Earn medals, build skills and work up the career ladder.</p>
            <span class="go">Play now →</span>
          </div>
        </a>
      </div>
    </section>

    <section id="contact">
      <div class="wrap narrow">
        <h2>Get in touch</h2>
        <p class="section-sub">
          Questions about an app, a privacy or data request, or just want to say hello? Email
          <a href={`mailto:${company.contactEmail}`}>{company.contactEmail}</a>.
        </p>
      </div>
    </section>
  </main>
</Base>
