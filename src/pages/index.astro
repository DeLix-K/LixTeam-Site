---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import ProductCard from '../components/ProductCard.astro';
import SectionHead from '../components/SectionHead.astro';
import StatusBadge from '../components/StatusBadge.astro';
import CtaBand from '../components/CtaBand.astro';
import { company } from '../data/company';
import { getProduct, liveProducts, upcomingProducts } from '../data/products';

const rootline = getProduct('rootline')!;
const fitnfree = getProduct('fitnfree')!;

const areas = [
  { name: 'Fitness & wellness', note: 'In the world today through FitNFree.' },
  { name: 'Cybersecurity', note: 'In the world today through ROOTLINE.' },
  { name: 'AI', note: 'Used inside our products, with people deciding.' },
  { name: 'Emerging technology', note: 'Tested in the lab before it becomes a product.' },
];

const orgLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: company.name,
  url: company.siteUrl,
  description: company.description,
});
---

<Base title={company.name} description={company.description} variant="lt">
  <script slot="head" type="application/ld+json" set:html={orgLd} />
  <main id="main">
    <!-- Hero -->
    <section class="lt-hero">
      <div class="lt-wrap lt-hero-grid">
        <div>
          <p class="lt-eyebrow">LixTeam</p>
          <h1 class="lt-h1">Building technology. Creating possibilities.</h1>
          <p class="lt-hero-sub">Ideas into products. Innovation into impact.</p>
          <p class="lt-lead">{company.description}</p>
          <div class="lt-btn-row">
            <a class="lt-btn lt-btn-light" href="/products/">Explore our products <span class="arrow" aria-hidden="true">→</span></a>
            <a class="lt-btn" href="/about/">Discover LixTeam</a>
          </div>
        </div>

        <div class="lt-stage">
          <div class="lt-window">
            <div class="lt-window-bar"><i></i><i></i><i></i></div>
            <Image src={rootline.hero!.src} alt={rootline.hero!.alt} width={1100} loading="eager" />
          </div>
          <div class="lt-phone">
            <Image src={fitnfree.hero!.src} alt={fitnfree.hero!.alt} width={420} loading="eager" />
          </div>
        </div>
      </div>
    </section>

    <!-- Products -->
    <section class="lt-section" id="products" style="padding-top:clamp(24px,4vw,56px)">
      <div class="lt-wrap">
        <SectionHead
          eyebrow="Products"
          title="Two products, one team behind them."
          text="Each product has its own identity and its own audience. Both are live today."
        />
        <div class="lt-cards">
          {liveProducts.map((p) => <ProductCard product={p} />)}
        </div>
      </div>
    </section>

    <!-- Company -->
    <section class="lt-section lt-band">
      <div class="lt-wrap lt-twocol">
        <div data-reveal>
          <p class="lt-eyebrow">The company</p>
          <h2 class="lt-h2">A product company, not an agency.</h2>
        </div>
        <div class="lt-prose" data-reveal style="--d:80ms">
          <p>
            We pick a problem, build the product ourselves, and <strong>operate it</strong>: the support inbox,
            the app-store reviews, the billing, the updates and the privacy requests. A product is not
            finished when it launches.
          </p>
          <p>
            We want LixTeam to become a company with several useful products, each one small enough to look
            after properly. Today that is a fitness and wellness app and a cybersecurity training game.
          </p>
          <p><a class="lt-link" href="/about/">About LixTeam <span class="arrow" aria-hidden="true">→</span></a></p>
        </div>
      </div>
    </section>

    <!-- Future -->
    <section class="lt-section" id="future">
      <div class="lt-wrap">
        <SectionHead
          eyebrow="What comes next"
          title="A portfolio that is built to grow."
          text="New ideas are tested the same way every time: a clear question, a small experiment, and a decision based on what people actually do. Nothing below is a promise, only what is in the lab."
        />

        <div class="lt-grid-2" style="margin-bottom:48px">
          {areas.map((a, i) => (
            <div class="lt-tile" data-reveal style={`--d:${i * 50}ms`}>
              <h3>{a.name}</h3>
              <p>{a.note}</p>
            </div>
          ))}
        </div>

        <div class="lt-rows" data-reveal>
          {upcomingProducts.map((p) => (
            <div class="lt-row">
              <div>
                <h3>{p.name}</h3>
                <p>{p.summary}</p>
              </div>
              <div style="display:flex;gap:20px;align-items:center;flex-wrap:wrap">
                <StatusBadge status={p.status} label={p.statusLabel} />
                {p.page && <a class="lt-link" href={p.page}>{p.cta.label} <span class="arrow" aria-hidden="true">→</span></a>}
              </div>
            </div>
          ))}
          <div class="lt-row">
            <div>
              <h3>Your idea</h3>
              <p>Building something that needs a team behind it, or have a problem worth solving? We would like to hear it.</p>
            </div>
            <a class="lt-link" href="/contact/">Get in touch <span class="arrow" aria-hidden="true">→</span></a>
          </div>
        </div>
      </div>
    </section>

    <CtaBand
      title="Explore the portfolio, or talk to us."
      text="See what we have built, try it, and tell us what you think."
      primary={{ label: 'Explore our products', href: '/products/' }}
      secondary={{ label: 'Contact LixTeam', href: '/contact/' }}
    />
  </main>
</Base>
