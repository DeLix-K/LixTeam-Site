---
import Logo from './Logo.astro';
import SocialLinks from './SocialLinks.astro';
import { company } from '../data/company';
import { visibleProducts } from '../data/products';
import { apps } from '../data/apps';

const listed = visibleProducts.filter((p) => p.page);
---
<footer class="lt-footer">
  <div class="lt-wrap">
    <div class="lt-footer-grid">
      <div class="lt-footer-about">
        <a class="lt-brand" href="/" aria-label={`${company.name} home`}>
          <Logo size={28} />
          <span>{company.name}</span>
        </a>
        <p>{company.tagline}</p>
        <SocialLinks />
      </div>

      <div>
        <h4>Products</h4>
        <ul>
          <li><a href="/products/">All products</a></li>
          {listed.map((p) => <li><a href={p.page!}>{p.name}</a></li>)}
        </ul>
      </div>

      <div>
        <h4>Company</h4>
        <ul>
          <li><a href="/about/">About</a></li>
          <li><a href="/contact/">Contact</a></li>
          <li><a href={`mailto:${company.contactEmail}`}>Email us</a></li>
        </ul>
      </div>

      <div>
        <h4>Legal &amp; help</h4>
        <ul>
          {apps.map((a) => (
            <>
              <li><a href={`/${a.slug}/privacy/`}>{a.name} privacy</a></li>
              <li><a href={`/${a.slug}/terms/`}>{a.name} terms</a></li>
              <li><a href={`/${a.slug}/support/`}>{a.name} support</a></li>
            </>
          ))}
          <li><a href="/games/privacy/">ROOTLINE privacy</a></li>
        </ul>
      </div>
    </div>

    <div class="lt-footer-base">
      <span>© {company.year} {company.name}. All rights reserved.</span>
      <span>{company.name} is the company behind FitNFree and ROOTLINE.</span>
    </div>
  </div>
</footer>
