---
import Logo from './Logo.astro';
import { company } from '../data/company';

const path = Astro.url.pathname;
const links = [
  { label: 'Products', href: '/products/', match: (p: string) => p.startsWith('/products') || p.startsWith('/games') },
  { label: 'About', href: '/about/', match: (p: string) => p.startsWith('/about') },
  { label: 'Contact', href: '/contact/', match: (p: string) => p.startsWith('/contact') },
];
---
<header class="lt-header">
  <div class="lt-wrap lt-header-row">
    <a class="lt-brand" href="/" aria-label={`${company.name} home`}>
      <Logo size={28} />
      <span>{company.name}</span>
    </a>

    <nav class="lt-nav" aria-label="Main">
      {links.map((l) => (
        <a href={l.href} aria-current={l.match(path) ? 'page' : undefined}>{l.label}</a>
      ))}
    </nav>

    <div class="lt-header-cta">
      <a class="lt-btn lt-btn-sm lt-btn-light" href="/products/">Explore products</a>
    </div>

    <details class="lt-menu">
      <summary aria-label="Menu"><span></span><span></span></summary>
      <div class="lt-menu-panel">
        {links.map((l) => <a href={l.href}>{l.label}</a>)}
      </div>
    </details>
  </div>
</header>
